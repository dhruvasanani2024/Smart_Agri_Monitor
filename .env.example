# ==============================================================================
# Smart Agri Monitor - Environment Configuration Template
# ==============================================================================

# 1. MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/smart_agri?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smart_agri?retryWrites=true&w=majority

# 2. Google Earth Engine Service Account Private Key
# Single-line JSON representation of your Google Cloud Service Account credentials.
# Must include "type", "project_id", "private_key", and "client_email".
# Note: Keep all on one line without outer enclosing quotes.
EE_PRIVATE_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project-id.iam.gserviceaccount.com"}
